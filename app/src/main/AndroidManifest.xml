<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!--
      Android 17 (targetSdk 37): hablar con la red local (tu servidor en 10.0.2.2,
      o en 192.168.x) exige este permiso, y se pide en tiempo de ejecución
      (ui/screens/RedLocalScreen.kt). Sin él, la conexión ni sale del teléfono.
    -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <application
        android:name=".CharlaApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Charla"
        android:supportsRtl="true"
        android:theme="@style/Theme.Charla">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          La cámara es OTRA app: no puede escribir en los archivos de Charla.
          FileProvider le presta una dirección content:// a un solo archivo
          (res/xml/fotos.xml) y ahí deja la foto.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fotos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/fotos" />
        </provider>
    </application>
</manifest>
